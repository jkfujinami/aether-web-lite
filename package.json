{
  "name": "aether-web-lite-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "web",
    "server"
  ],
  "scripts": {
    "dev": "npm --workspace=web run dev",
    "test": "npm --workspace=web test",
    "test:all": "npm test --workspaces --if-present",
    "build:core": "npm --workspace=@aether/core run build"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
